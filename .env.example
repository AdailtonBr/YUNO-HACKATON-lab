# ---------------------------------------------------------------------------
# Demo: Agente de Recontratacao de Energia (Yuno x Nauta)
# ---------------------------------------------------------------------------

# UM deslocamento move TUDO junto: Autoridade, comercializadoras e UI.
# E o que permite as tres maquinas rodarem a pilha inteira ao mesmo tempo.
#
#   Dispositivo 1 (Frente A)      PORT_OFFSET=0    -> 3001 / 4001-4003 / 5173
#   Dispositivo 2 (Frente B)      PORT_OFFSET=10   -> 3011 / 4011-4013 / 5183
#   Dispositivo 2 (Frente C)      PORT_OFFSET=20   -> 3021 / 4021-4023 / 5193
#   Dispositivo 3 (Frente D)      PORT_OFFSET=30   -> 3031 / 4031-4033 / 5203
#
# `npm test` NAO precisa disto: os testes sobem tudo em portas efemeras.
PORT_OFFSET=0

# Sem MONGODB_URI, a Autoridade sobe com Mongo em memoria e ja semeia a demo.
# Com ela, os dados persistem entre restarts.
# MONGODB_URI=mongodb+srv://USER:SENHA@cluster.mongodb.net/mandato_agentico
#
# `mongodb+srv://` depende de registro SRV no DNS, e algumas redes nao devolvem
# esse tipo de registro ("querySrv ENOTFOUND") mesmo com a string certa. Por
# isso o processo aponta para um DNS publico quando a URI e +srv.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Credencial do agente da Aurora (o segredo do bilhete assinado).
AGENT_ID=agent_aurora
AGENT_SECRET=demo-agent-secret-aurora
HUMAN_ID=user_aurora

# Enderecos explicitos (opcional -- por padrao saem do PORT_OFFSET acima).
# AUTHORITY_URL=http://127.0.0.1:3001
# STORE_VOLT_URL=http://127.0.0.1:4001
# STORE_CERRADO_URL=http://127.0.0.1:4002
# STORE_HELIOS_URL=http://127.0.0.1:4003

# O vigia (ciclo diario). `off` desliga para rodar a Autoridade sem ninguem
# comprando sozinho -- util enquanto se mexe no motor.
# WATCHER=off
# WATCHER_INTERVAL_MS=5000

# ---------------------------------------------------------------------------
# LLM -- FORA do caminho da demo de energia.
# O mandato de 6 camadas e emitido no Portal do Gestor, por formulario.
# `llm.js` fica dormente no repo: nao custa nada e continua sendo a prova de
# que IA rascunha e o deterministico decide.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
